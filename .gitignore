input/*
!input/.gitkeep

# Logs / runs por timestamp (local, p. ej. 20260727T133449)
2026*/
garbage/*
!garbage/.gitkeep
latest

# Cache de Python
__pycache__/
*.pyc
*.pyo

# Estado de subidas (no es código, es runtime state)
done_*.json

# PDF de instrucciones (no es código del proyecto)
HWDB_Instructions_and_Commands-1.pdf

# Metadatos de Windows
*Zone.Identifier
